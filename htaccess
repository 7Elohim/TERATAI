# ------------------------------------------------------
# 1. Aktifkan mod_rewrite untuk URL rewriting & redirect
# ------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1.1 Hilangkan "www." (duluan supaya redirect hanya sekali)
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

    # 1.2 Redirect HTTP ke HTTPS
    RewriteCond %{HTTPS} !=on
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # 1.3 Redirect .php/.html → extensionless URL
    RewriteCond %{THE_REQUEST} \s/+(.*?)(?:\.php|\.html)[\s?] [NC]
    RewriteRule ^ %1 [R=301,L]

    # 1.4 Internal rewrite extensionless → file.php/html
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.+?)/?$ $1.php [L]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

# ------------------------------------------------------
# 2. Keamanan dasar
# ------------------------------------------------------

<Files ".htaccess">
    Require all denied
</Files>

Options -Indexes

<RequireAll>
    Require all granted
    Require not ip 192.168.1.1
</RequireAll>

ErrorDocument 404 /404.html
ErrorDocument 500 /500.html

# ------------------------------------------------------
# 3. Kompresi dan cache
# ------------------------------------------------------

# Gzip Compression Lengkap
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain text/html text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript
    AddOutputFilterByType DEFLATE application/json application/ld+json
    AddOutputFilterByType DEFLATE application/xml application/xhtml+xml
    AddOutputFilterByType DEFLATE font/ttf font/otf image/svg+xml
</IfModule>

# MIME type JS
<IfModule mod_mime.c>
    AddType application/javascript .js
</IfModule>

# Cegah cache untuk file dinamis
<IfModule mod_headers.c>
    <FilesMatch "\.(html|htm|php|json)$">
        Header set Cache-Control "no-store, no-cache, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
</IfModule>

# Browser Caching
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/gif "access plus 30 days"
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType text/javascript "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresDefault "access plus 7 days"
</IfModule>

# ------------------------------------------------------
# 4. Header Keamanan
# ------------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-XSS-Protection "1; mode=block"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(self), microphone=(), camera=()"
    Header set Access-Control-Allow-Origin "*"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
</IfModule>

# ------------------------------------------------------
# 5. JSON support
# ------------------------------------------------------
<FilesMatch "\.json$">
    Header set Content-Type "application/json; charset=UTF-8"
    Header set Access-Control-Allow-Origin "*"
</FilesMatch>